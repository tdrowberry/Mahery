node_modules
dist
*.local

# Capacitor native projects: keep the hand-authored project config (build.gradle,
# AndroidManifest.xml, res/, gradle wrapper), but not build output or the web build that
# `npx cap sync` copies in from dist/ on every sync - both are regenerated, not source.
android/app/build/
android/build/
android/.gradle/
android/capacitor-cordova-android-plugins/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json

# Debug/release build artifacts
*.apk
*.aab

# Music/video dropped at the project root, not yet wired into the game (no code references
# them) - leave them out of the repo until they're actually integrated as real game assets.
/*.mp3
/*.mp4
*.tsbuildinfo
